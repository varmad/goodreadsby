# Claude Code OAuth token — get one by running `claude setup-token` on your host.
# Lets the agent use your Claude subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# Or use an Anthropic API key instead — uncomment and fill in:
# ANTHROPIC_API_KEY=

# --- Issue tracker: Jira Cloud (used by the jira-task helper) ---
# Base URL of the Jira site, no trailing slash.
JIRA_URL=https://srinivasavarmad.atlassian.net
# Atlassian account email — the username half of the API token's basic auth.
JIRA_EMAIL=
# API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Project key the loop pulls work from.
JIRA_DEFAULT_PROJECT=SCRUM
# Comma-separated statuses that count as "open and pickable" for `jira-task list`.
JIRA_WORK_STATUSES=To Do
# Status an issue moves to once its pull request is open. Must be reachable
# from a work status in the project's workflow, and must NOT be listed in
# JIRA_WORK_STATUSES or the loop will pick the same issue up again.
JIRA_REVIEW_STATUS=In Review

# --- GitHub: push + pull request per issue (used by the gh-pr helper) ---
# Fine-grained or classic PAT with Contents: read/write and Pull requests:
# read/write on this repo. https://github.com/settings/tokens
GH_TOKEN=
# owner/name of the repo to push to. Optional — falls back to the `origin`
# remote of this checkout.
# GITHUB_REPO=
# Branch every PR targets. Optional — defaults to main.
# PR_BASE_BRANCH=main
# Set to 1 to open pull requests as drafts.
# PR_DRAFT=
